{
  "name": "pi-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "A local desktop workspace for Pi coding agent",
  "author": "Pi Desktop contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/native.mjs dev",
    "dev:web": "vite",
    "start": "node scripts/native.mjs start",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "node scripts/native.mjs cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:ui": "npm run build:test && node tests/tauri-smoke.mjs",
    "test:pi": "node scripts/native.mjs cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --bin pi-rpc-check",
    "test:context": "node scripts/native.mjs cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --bin pi-workspace-check",
    "test:agent:contract": "node tests/agent-contract.mjs",
    "package": "node scripts/native.mjs build --no-bundle && node scripts/stage-native.mjs",
    "build:test": "npm run build && node scripts/native.mjs build --debug --no-bundle --features test-fixture",
    "legacy:dev": "node scripts/dev.mjs",
    "legacy:start": "electron .",
    "legacy:test:ui": "node tests/electron-smoke.mjs",
    "legacy:package": "npm run build && electron-builder --win dir",
    "check:cloud": "node scripts/verify.mjs cloud",
    "check:windows": "node scripts/verify.mjs windows"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.2.3",
    "electron-builder": "^26.0.0",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "local.pi.desktop",
    "productName": "Pi Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
